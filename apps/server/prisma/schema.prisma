generator client {
  provider = "prisma-client-js"
}

datasource db {
  provider = "sqlite"
  url      = env("DATABASE_URL")
}

model Device {
  id        String   @id @default(cuid())
  ip        String   @unique
  mac       String?
  hostname  String?
  vendor    String?
  lastSeen  DateTime @default(now())
  createdAt DateTime @default(now())
}

model EventLog {
  id        String   @id @default(cuid())
  type      String
  message   String
  createdAt DateTime @default(now())
}
